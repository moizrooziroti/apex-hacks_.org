---
import { t } from '../i18n';
import { hackPages } from '../data/products';
import { hackTierIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
const s = t.hacks;
---

<section id="hacks" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="hacks-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="hacks-title" />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {hackPages.map((hack, i) => (
        <CatalogCard
          label={hack.tier ?? hack.name}
          title={hack.title}
          buyUrl={hack.buyUrl}
          features={hack.features}
          more={hack.more}
          icon={hackTierIcons[hack.name] ?? 'crosshair'}
          badge={hack.badge}
          variant={hack.variant}
          buyLabel="Buy now"
        />
      ))}
    </div>
  </div>
</section>
